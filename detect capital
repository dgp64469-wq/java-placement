class Solution {
    public boolean detectCapitalUse(String word) {
        if(word.equals(word.toUpperCase())){
            return true;
        }
        if(word.equals(word.toUpperCase())){
            return false;
        }
        String fristCapital = Character.toUpperCase(word.charAt(0)) + word.substring(1).toLowerCase();
        return word.equals(fristCapital);
    }
}de
